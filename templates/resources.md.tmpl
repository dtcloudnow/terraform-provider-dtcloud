{{- /*
Default page template for every resource.

Only this file and its data-sources sibling decide how a resource page looks, so
a new resource needs no template of its own: give the schema.Resource a
Description, drop an example under examples/resources/<name>/, and the page
appears. Add templates/resources/<name>.md.tmpl only when one page needs prose
the schema cannot carry.

`subcategory` is the Registry's left-hand grouping. It is set here rather than
per page so the whole grouping is visible in one place, and it is what the
Docusaurus converter reads to build its folders -- keep a new resource out of
the chain below and it lands in "Other" on both sites.
*/ -}}
{{- $sub := "Other" -}}
{{- if or (eq .Name "dtcloud_vm") (eq .Name "dtcloud_vm_network_interface") (eq .Name "dtcloud_vm_volume_attachment") -}}{{- $sub = "Compute" -}}{{- end -}}
{{- if or (eq .Name "dtcloud_network") (eq .Name "dtcloud_security_group") (eq .Name "dtcloud_security_group_rule") (eq .Name "dtcloud_elastic_ip") -}}{{- $sub = "Networking" -}}{{- end -}}
{{- if or (eq .Name "dtcloud_volume") (eq .Name "dtcloud_snapshot") -}}{{- $sub = "Storage" -}}{{- end -}}
{{- if eq .Name "dtcloud_image" -}}{{- $sub = "Images" -}}{{- end -}}
{{- if eq .Name "dtcloud_ssh_key" -}}{{- $sub = "Access" -}}{{- end -}}
---
# generated by tfplugindocs from the provider schema -- do not edit by hand.
# Edit the Description strings on the resource's schema.Resource in dtcloud/, the
# example under examples/resources/{{ .Name }}/, or templates/resources.md.tmpl,
# then run `make docs`.
page_title: "{{ .Name }} {{ .Type }} - {{ .ProviderName }}"
subcategory: "{{ $sub }}"
description: |-
{{ .Description | plainmarkdown | trimspace | prefixlines "  " }}
---

